#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

export HEMERA_CONFIG_DIR="/data"
export HEMERA_HTTP_PORT="80"
export HEMERA_HTTPS_PORT="443"
export HEMERA_LOG_LEVEL="$(bashio::config 'log_level' | tr '[:lower:]' '[:upper:]')"
export HEMERA_ENTERTAINMENT_FPS="$(bashio::config 'entertainment_fps')"

if bashio::config.has_value 'mac'; then
    export HEMERA_MAC="$(bashio::config 'mac')"
else
    bashio::log.warning "No MAC configured — auto-detecting one, which can pick the wrong interface under host networking and break pairing with the official Hue app. If pairing shows \"press the button\" forever, set the 'mac' option to your host's real network MAC address."
fi

if bashio::config.has_value 'timezone'; then
    export HEMERA_TIMEZONE="$(bashio::config 'timezone')"
else
    # Falls back to Home Assistant's own configured timezone (Settings ->
    # General) rather than a hardcoded default — avoids the Hue app's
    # "configure your bridge's timezone" prompt on first pairing for the
    # common case where the user never touches this option.
    export HEMERA_TIMEZONE="$(bashio::info.timezone)"
fi

# MQTT connection settings are not add-on options — the admin panel (port
# 8099) is the only way to configure them, and stays authoritative across
# restarts once set (see main.py's is_first_run handling). This only seeds
# a starting point on a brand new install.
if bashio::services.available 'mqtt'; then
    bashio::log.info "Auto-discovering the Mosquitto broker add-on"
    export HEMERA_MQTT_HOST="$(bashio::services 'mqtt' 'host')"
    export HEMERA_MQTT_PORT="$(bashio::services 'mqtt' 'port')"
    export HEMERA_MQTT_USER="$(bashio::services 'mqtt' 'username')"
    export HEMERA_MQTT_PASSWORD="$(bashio::services 'mqtt' 'password')"
else
    bashio::log.warning "No Mosquitto add-on found — configure your MQTT broker from the admin panel (port 8099)"
    export HEMERA_MQTT_HOST="127.0.0.1"
    export HEMERA_MQTT_PORT="1883"
fi

bashio::log.info "Starting Hemera..."
exec python3 -m hemera.main
